{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schemas/fulltable/ablation_mapping.schema.json",
  "title": "fulltable/ablation_mapping",
  "type": "array",
  "minItems": 8,
  "maxItems": 8,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["flag", "difficulty", "target_metrics"],
    "properties": {
      "flag": {
        "type": "string",
        "enum": [
          "NoCapabilityDiscovery",
          "NoTypedContracts",
          "NoDryRun",
          "NoContractFormalization",
          "NoUserPromotionPath",
          "NoAcceptanceGate",
          "NoRegistryLookup",
          "NoObserver"
        ]
      },
      "difficulty": {
        "type": "string",
        "enum": ["难点一", "难点二", "难点三"]
      },
      "target_metrics": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    }
  }
}
